{
    "keyboard_name": "Ploopy Bean",
    "url": "www.ploopy.co",
    "maintainer": "ploopyco",
    "manufacturer": "Ploopy Corporation",
    "processor": "RP2040",
    "bootloader": "rp2040",
    "usb": {
        "vid": "0x5043",
        "pid": "0x81DC",
        "max_power": 100
    },
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "pointing_device": true,
        "rgblight": false,
        "os_detection": true
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "label":"Top Left", "x":0, "y":0, "h":2},
                {"matrix": [0, 1], "label":"Top Right", "x":3, "y":0, "h":2},
                {"matrix": [0, 2], "label":"Bottom Left", "x":0, "y":3, "w":2, "h":2},
                {"matrix": [0, 3], "label":"Bottom Right", "x":3, "y":3, "w":2, "h":2}
            ]
        }
    }
}
