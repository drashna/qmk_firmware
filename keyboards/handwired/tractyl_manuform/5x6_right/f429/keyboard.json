{
    "keyboard_name": "Tractyl Manuform (5x6) WeAct STM32F429",
    "audio": {
        "driver": "dac_additive",
        "power_control": {
            "pin": "A3"
        }
    },
    "backlight": {
        "levels": 16,
        "pin": "C8"
    },
    "bootloader": "tinyuf2",
    "build": {
        "debounce_type": "asym_eager_defer_pk"
    },
    "diode_direction": "COL2ROW",
    "encoder": {
        "rotary": [
            {"pin_a": "B10", "pin_b": "B11"}
        ]
    },
    "eeprom": {
        "driver": "wear_leveling",
        "wear_leveling": {
            "driver": "spi_flash",
            "backing_size": 16384,
            "logical_size": 4096
        }
    },
    "features": {
        "console": true,
        "haptic": true
    },
    "haptic": {
        "driver": "drv2605l"
    },
    "matrix_pins": {
        "cols": ["F6", "F7", "F8", "F9", "C1", "C2"],
        "rows": ["C3", "A1", "A2", "H4", "H5", "A6"]
    },
    "rgblight": {
        "led_count": 24,
        "split": true
    },
    "split": {
        "handedness": {
            "pin": "C4"
        },
        "serial": {
            "driver": "usart"
        },
        "transport": {
            "sync": {
                "activity": true,
                "haptic": true,
                "matrix_state": true
            },
            "watchdog": true
        }
    },
    "ws2812": {
        "driver": "pwm",
        "pin": "C9"
    }
}
